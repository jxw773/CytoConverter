# Taking all reads with ? and ~ as well into dump table
# Adding marker and add material as well
unsure_table <- Con_data[grep("\\?|\\~|inc|mar|add", Con_data[, 2]), ]
Dump_table <- if (is.vector(unsure_table)) {
rbind(
Dump_table,
c(
